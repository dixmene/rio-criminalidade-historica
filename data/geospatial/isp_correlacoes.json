  "testes_de_hipotese": {
    "hipotese_1_letalidade_policial_vs_homicidio_doloso": {
      "descricao": "Testa se a letalidade policial reduz homicídios dolosos no mesmo mês (t) ou no mês seguinte (t+1).",
      "mesmo_periodo_t": {
        "n_observacoes": 283,
        "pearson": {
          "r": 0.153,
          "p_value": 0.0099322,
          "ci_95_low": 0.0371,
          "ci_95_high": 0.2649,
          "significativo_p05": true
        },
        "spearman": {
          "rho": 0.2168,
          "p_value": 0.00023867,
          "significativo_p05": true
        }
      },
      "defasagem_t_mais_1": {
        "n_observacoes": 282,
        "pearson": {
          "r": 0.0956,
          "p_value": 0.10925,
          "ci_95_low": -0.0215,
          "ci_95_high": 0.21,
          "significativo_p05": false
        },
        "spearman": {
          "rho": 0.164,
          "p_value": 0.0057812,
          "significativo_p05": true
        }
      },
      "reacao_policial_hom_t_letalidade_t_mais_1": {
        "n_observacoes": 282,
        "pearson": {
          "r": 0.2023,
          "p_value": 0.00063019,
          "ci_95_low": 0.0876,
          "ci_95_high": 0.3118,
          "significativo_p05": true
        },
        "spearman": {
          "rho": 0.2649,
          "p_value": 6.5221e-06,
          "significativo_p05": true
        }
      },
      "conclusao_estatistica": "No nível agregado estadual, a correlação contemporânea é positiva (Pearson r=0.153, p=0.0099322; Spearman rho=0.2168). Com defasagem de 1 mês (t+1), o efeito dissuasório não se confirma (Pearson r=0.0956, p=0.10925). Portanto, os microdados refutam a hipótese de que o aumento de mortes por intervenção policial produza redução subsequente de homicídios dolosos."
    },
