# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE - PESQUISA HISTÓRICA DO RIO DE JANEIRO
# ==============================================================================

# Ambiente de execução: development, staging, production
ENVIRONMENT=development
DEBUG=True
APP_NAME="Mapa Histórico e Territorial da Criminalidade no RJ"

# Conexão com o Banco de Dados
# 1. Modo Local / Desenvolvimento Inicial (Zero Config):
DATABASE_URL=sqlite:///./data/rio_historico.db

# 2. Modo PostgreSQL / PostGIS (Produção / Homologação):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rio_criminalidade_db

# Parâmetros de Ingestão e Armazenamento
DATA_RAW_DIR=./data/raw
DATA_STAGING_DIR=./data/staging
DATA_PROCESSED_DIR=./data/processed
DATA_GEOSPATIAL_DIR=./data/geospatial

# Mapas & Coordenadas Padrão (Centro do Rio de Janeiro)
MAP_DEFAULT_LAT=-22.9068
MAP_DEFAULT_LON=-43.1729
MAP_DEFAULT_ZOOM=11
